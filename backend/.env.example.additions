# Add these to your Laravel .env file

# --- AI Providers ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
STT_PROVIDER=openai
MT_PROVIDER=openai
TTS_PROVIDER=openai

# --- Broadcasting (Laravel Reverb - self-hosted WebSocket server) ---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=translator-app
REVERB_APP_KEY=translator-key
REVERB_APP_SECRET=translator-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# --- Filesystem (where synthesized mp3 files are stored/served) ---
FILESYSTEM_DISK=public

# --- CORS: allow the Next.js frontend origin ---
FRONTEND_URL=http://localhost:3000
